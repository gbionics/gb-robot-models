<?xml version="1.0"?>
<robot name="primitive_humanoid">

  <!-- Coordinate convention: x forward, y left, z up. -->

  <material name="body_blue">
    <color rgba="0.18 0.42 0.72 1.0"/>
  </material>
  <material name="joint_gray">
    <color rgba="0.30 0.32 0.35 1.0"/>
  </material>
  <material name="skin">
    <color rgba="0.82 0.62 0.48 1.0"/>
  </material>
  <material name="foot_dark">
    <color rgba="0.12 0.14 0.17 1.0"/>
  </material>

  <!-- Root / pelvis -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.24 0.30 0.16"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <geometry><box size="0.24 0.30 0.16"/></geometry>
    </collision>
    <inertial>
      <mass value="6.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0578" ixy="0" ixz="0"
               iyy="0.0416" iyz="0" izz="0.0738"/>
    </inertial>
  </link>

  <!-- Torso -->
  <link name="torso_link">
    <visual>
      <origin xyz="0 0 0.23"/>
      <geometry><box size="0.28 0.42 0.46"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.23"/>
      <geometry><box size="0.28 0.42 0.46"/></geometry>
    </collision>
    <inertial>
      <mass value="11.0"/>
      <origin xyz="0 0 0.23"/>
      <inertia ixx="0.3555" ixy="0" ixz="0"
               iyy="0.2657" iyz="0" izz="0.2336"/>
    </inertial>
  </link>

  <joint name="waist_yaw_joint" type="revolute">
    <parent link="base_link"/>
    <child link="torso_link"/>
    <origin xyz="0 0 0.08"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="120" velocity="1.5"/>
    <dynamics damping="0.8" friction="0.1"/>
  </joint>

  <!-- Neck and head -->
  <link name="neck_link">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.055" length="0.10"/></geometry>
      <material name="joint_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.055" length="0.10"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0.05"/>
      <inertia ixx="0.000795" ixy="0" ixz="0"
               iyy="0.000795" iyz="0" izz="0.000756"/>
    </inertial>
  </link>

  <joint name="neck_yaw_joint" type="revolute">
    <parent link="torso_link"/>
    <child link="neck_link"/>
    <origin xyz="0 0 0.46"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.0" upper="1.0" effort="15" velocity="2.0"/>
    <dynamics damping="0.2"/>
  </joint>

  <link name="head_link">
    <visual>
      <origin xyz="0 0 0.12"/>
      <geometry><box size="0.20 0.18 0.24"/></geometry>
      <material name="skin"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.12"/>
      <geometry><box size="0.20 0.18 0.24"/></geometry>
    </collision>
    <inertial>
      <mass value="3.2"/>
      <origin xyz="0 0 0.12"/>
      <inertia ixx="0.0240" ixy="0" ixz="0"
               iyy="0.0267" iyz="0" izz="0.0190"/>
    </inertial>
  </link>

  <joint name="neck_pitch_joint" type="revolute">
    <parent link="neck_link"/>
    <child link="head_link"/>
    <origin xyz="0 0 0.10"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.65" upper="0.65" effort="15" velocity="2.0"/>
    <dynamics damping="0.2"/>
  </joint>

  <!-- The only non-primitive geometry: a separate STL face. -->
  <link name="face_link">
    <visual>
      <geometry>
        <mesh filename="package://gb_robot_models/meshes/face.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="skin"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://gb_robot_models/meshes/face.stl"
              scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <origin xyz="0.01 0 0"/>
      <inertia ixx="0.00020" ixy="0" ixz="0"
               iyy="0.00015" iyz="0" izz="0.00015"/>
    </inertial>
  </link>

  <joint name="face_fixed_joint" type="fixed">
    <parent link="head_link"/>
    <child link="face_link"/>
    <!-- Head front is at x=0.10; add a small offset to prevent z-fighting. -->
    <origin xyz="0.101 0 0.12"/>
  </joint>

  <!-- Left arm -->
  <link name="left_upper_arm_link">
    <visual>
      <origin xyz="0 0 -0.14"/>
      <geometry><cylinder radius="0.045" length="0.28"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.14"/>
      <geometry><cylinder radius="0.045" length="0.28"/></geometry>
    </collision>
    <inertial>
      <mass value="1.4"/>
      <origin xyz="0 0 -0.14"/>
      <inertia ixx="0.0096" ixy="0" ixz="0"
               iyy="0.0096" iyz="0" izz="0.00142"/>
    </inertial>
  </link>

  <joint name="left_shoulder_pitch_joint" type="revolute">
    <parent link="torso_link"/>
    <child link="left_upper_arm_link"/>
    <origin xyz="0 0.255 0.36"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="45" velocity="2.5"/>
    <dynamics damping="0.3"/>
  </joint>

  <link name="left_forearm_link">
    <visual>
      <origin xyz="0 0 -0.125"/>
      <geometry><cylinder radius="0.040" length="0.25"/></geometry>
      <material name="joint_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.125"/>
      <geometry><cylinder radius="0.040" length="0.25"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 -0.125"/>
      <inertia ixx="0.00561" ixy="0" ixz="0"
               iyy="0.00561" iyz="0" izz="0.00080"/>
    </inertial>
  </link>

  <joint name="left_elbow_joint" type="revolute">
    <parent link="left_upper_arm_link"/>
    <child link="left_forearm_link"/>
    <origin xyz="0 0 -0.28"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.45" effort="35" velocity="2.5"/>
    <dynamics damping="0.25"/>
  </joint>

  <link name="left_hand_link">
    <visual>
      <origin xyz="0 0 -0.08"/>
      <geometry><box size="0.12 0.08 0.16"/></geometry>
      <material name="skin"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.08"/>
      <geometry><box size="0.12 0.08 0.16"/></geometry>
    </collision>
    <inertial>
      <mass value="0.45"/>
      <origin xyz="0 0 -0.08"/>
      <inertia ixx="0.00120" ixy="0" ixz="0"
               iyy="0.00150" iyz="0" izz="0.00078"/>
    </inertial>
  </link>

  <joint name="left_wrist_joint" type="revolute">
    <parent link="left_forearm_link"/>
    <child link="left_hand_link"/>
    <origin xyz="0 0 -0.25"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.7" upper="0.7" effort="12" velocity="3.0"/>
    <dynamics damping="0.1"/>
  </joint>

  <!-- Right arm -->
  <link name="right_upper_arm_link">
    <visual>
      <origin xyz="0 0 -0.14"/>
      <geometry><cylinder radius="0.045" length="0.28"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.14"/>
      <geometry><cylinder radius="0.045" length="0.28"/></geometry>
    </collision>
    <inertial>
      <mass value="1.4"/>
      <origin xyz="0 0 -0.14"/>
      <inertia ixx="0.0096" ixy="0" ixz="0"
               iyy="0.0096" iyz="0" izz="0.00142"/>
    </inertial>
  </link>

  <joint name="right_shoulder_pitch_joint" type="revolute">
    <parent link="torso_link"/>
    <child link="right_upper_arm_link"/>
    <origin xyz="0 -0.255 0.36"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="45" velocity="2.5"/>
    <dynamics damping="0.3"/>
  </joint>

  <link name="right_forearm_link">
    <visual>
      <origin xyz="0 0 -0.125"/>
      <geometry><cylinder radius="0.040" length="0.25"/></geometry>
      <material name="joint_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.125"/>
      <geometry><cylinder radius="0.040" length="0.25"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 -0.125"/>
      <inertia ixx="0.00561" ixy="0" ixz="0"
               iyy="0.00561" iyz="0" izz="0.00080"/>
    </inertial>
  </link>

  <joint name="right_elbow_joint" type="revolute">
    <parent link="right_upper_arm_link"/>
    <child link="right_forearm_link"/>
    <origin xyz="0 0 -0.28"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.45" effort="35" velocity="2.5"/>
    <dynamics damping="0.25"/>
  </joint>

  <link name="right_hand_link">
    <visual>
      <origin xyz="0 0 -0.08"/>
      <geometry><box size="0.12 0.08 0.16"/></geometry>
      <material name="skin"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.08"/>
      <geometry><box size="0.12 0.08 0.16"/></geometry>
    </collision>
    <inertial>
      <mass value="0.45"/>
      <origin xyz="0 0 -0.08"/>
      <inertia ixx="0.00120" ixy="0" ixz="0"
               iyy="0.00150" iyz="0" izz="0.00078"/>
    </inertial>
  </link>

  <joint name="right_wrist_joint" type="revolute">
    <parent link="right_forearm_link"/>
    <child link="right_hand_link"/>
    <origin xyz="0 0 -0.25"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.7" upper="0.7" effort="12" velocity="3.0"/>
    <dynamics damping="0.1"/>
  </joint>

  <!-- Left leg -->
  <link name="left_thigh_link">
    <visual>
      <origin xyz="0 0 -0.20"/>
      <geometry><cylinder radius="0.055" length="0.40"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.20"/>
      <geometry><cylinder radius="0.055" length="0.40"/></geometry>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <origin xyz="0 0 -0.20"/>
      <inertia ixx="0.0547" ixy="0" ixz="0"
               iyy="0.0547" iyz="0" izz="0.00605"/>
    </inertial>
  </link>

  <joint name="left_hip_pitch_joint" type="revolute">
    <parent link="base_link"/>
    <child link="left_thigh_link"/>
    <origin xyz="0 0.09 -0.08"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.3" upper="1.0" effort="120" velocity="2.0"/>
    <dynamics damping="0.6"/>
  </joint>

  <link name="left_shin_link">
    <visual>
      <origin xyz="0 0 -0.20"/>
      <geometry><cylinder radius="0.050" length="0.40"/></geometry>
      <material name="joint_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.20"/>
      <geometry><cylinder radius="0.050" length="0.40"/></geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <origin xyz="0 0 -0.20"/>
      <inertia ixx="0.0408" ixy="0" ixz="0"
               iyy="0.0408" iyz="0" izz="0.00375"/>
    </inertial>
  </link>

  <joint name="left_knee_joint" type="revolute">
    <parent link="left_thigh_link"/>
    <child link="left_shin_link"/>
    <origin xyz="0 0 -0.40"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.25" effort="120" velocity="2.0"/>
    <dynamics damping="0.6"/>
  </joint>

  <link name="left_foot_link">
    <visual>
      <origin xyz="0.055 0 -0.035"/>
      <geometry><box size="0.24 0.10 0.07"/></geometry>
      <material name="foot_dark"/>
    </visual>
    <collision>
      <origin xyz="0.055 0 -0.035"/>
      <geometry><box size="0.24 0.10 0.07"/></geometry>
    </collision>
    <inertial>
      <mass value="0.9"/>
      <origin xyz="0.055 0 -0.035"/>
      <inertia ixx="0.00112" ixy="0" ixz="0"
               iyy="0.00469" iyz="0" izz="0.00507"/>
    </inertial>
  </link>

  <joint name="left_ankle_pitch_joint" type="revolute">
    <parent link="left_shin_link"/>
    <child link="left_foot_link"/>
    <origin xyz="0 0 -0.40"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.65" upper="0.65" effort="70" velocity="2.5"/>
    <dynamics damping="0.4"/>
  </joint>

  <!-- Right leg -->
  <link name="right_thigh_link">
    <visual>
      <origin xyz="0 0 -0.20"/>
      <geometry><cylinder radius="0.055" length="0.40"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.20"/>
      <geometry><cylinder radius="0.055" length="0.40"/></geometry>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <origin xyz="0 0 -0.20"/>
      <inertia ixx="0.0547" ixy="0" ixz="0"
               iyy="0.0547" iyz="0" izz="0.00605"/>
    </inertial>
  </link>

  <joint name="right_hip_pitch_joint" type="revolute">
    <parent link="base_link"/>
    <child link="right_thigh_link"/>
    <origin xyz="0 -0.09 -0.08"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.3" upper="1.0" effort="120" velocity="2.0"/>
    <dynamics damping="0.6"/>
  </joint>

  <link name="right_shin_link">
    <visual>
      <origin xyz="0 0 -0.20"/>
      <geometry><cylinder radius="0.050" length="0.40"/></geometry>
      <material name="joint_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.20"/>
      <geometry><cylinder radius="0.050" length="0.40"/></geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <origin xyz="0 0 -0.20"/>
      <inertia ixx="0.0408" ixy="0" ixz="0"
               iyy="0.0408" iyz="0" izz="0.00375"/>
    </inertial>
  </link>

  <joint name="right_knee_joint" type="revolute">
    <parent link="right_thigh_link"/>
    <child link="right_shin_link"/>
    <origin xyz="0 0 -0.40"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.25" effort="120" velocity="2.0"/>
    <dynamics damping="0.6"/>
  </joint>

  <link name="right_foot_link">
    <visual>
      <origin xyz="0.055 0 -0.035"/>
      <geometry><box size="0.24 0.10 0.07"/></geometry>
      <material name="foot_dark"/>
    </visual>
    <collision>
      <origin xyz="0.055 0 -0.035"/>
      <geometry><box size="0.24 0.10 0.07"/></geometry>
    </collision>
    <inertial>
      <mass value="0.9"/>
      <origin xyz="0.055 0 -0.035"/>
      <inertia ixx="0.00112" ixy="0" ixz="0"
               iyy="0.00469" iyz="0" izz="0.00469"/>
    </inertial>
  </link>

  <joint name="right_ankle_pitch_joint" type="revolute">
    <parent link="right_shin_link"/>
    <child link="right_foot_link"/>
    <origin xyz="0 0 -0.40"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.65" upper="0.65" effort="70" velocity="2.5"/>
    <dynamics damping="0.4"/>
  </joint>

</robot>
